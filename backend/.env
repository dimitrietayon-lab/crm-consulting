DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_consulting?schema=public"
JWT_SECRET="crm-consulting-super-secret-jwt-key-2024-change-in-production"
PORT=3001
UPLOAD_DIR="./uploads"
APPROVAL_THRESHOLD=50000
NODE_ENV=development

# KI & News (Nice-to-Have modules 13-16)
ANTHROPIC_API_KEY=
NEWS_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@crm-consulting.de

# OAuth2 – Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# OAuth2 – Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
